{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Athena Dashboard",
  "version": "../package.json",
  "identifier": "ca.frc6390.athena.dashboard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Athena Dashboard",
        "width": 1520,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FRC 6390",
    "category": "DeveloperTool",
    "shortDescription": "Athena robot host dashboard",
    "longDescription": "Athena Dashboard is the host-side control and monitoring dashboard for the FRC 6390 Athena robot runtime. It connects to the robot over ARCP and NetworkTables to show live telemetry, subscriptions and controls.",
    "copyright": "Copyright (c) FRC 6390 Athena",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.svg"
    ]
  }
}
